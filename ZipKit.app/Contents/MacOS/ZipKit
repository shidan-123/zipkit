#!/bin/bash
# ZipKit 大文件版 —— macOS 应用启动器
# 被双击时由 launchd 直接执行，不会弹终端窗口。
# 任何失败都会写进 ~/Library/Logs/ZipKit.log 并弹出可读的提示。

HERE="$(cd "$(dirname "$0")" && pwd)"
PROJECT="$(cd "$HERE/../../.." && pwd)"
LOG="${ZIPKIT_LOG:-$HOME/Library/Logs/ZipKit.log}"
mkdir -p "$(dirname "$LOG")"

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

show_error() {
  local msg="$1"
  log "ERROR: $msg"
  msg="${msg//\"/\\\"}"
  /usr/bin/osascript -e "display dialog \"$msg\" with title \"ZipKit 打不开\" buttons {\"好\"} default button 1 with icon caution" >/dev/null 2>&1
}

log "=== 启动 === 项目目录: $PROJECT"

if [ ! -f "$PROJECT/zipkit/cli.py" ]; then
  show_error "找不到程序文件：$PROJECT/zipkit/cli.py

请确认 ZipKit.app 还在原来的文件夹（zipkit/）里，不要单独拖走。

日志：~/Library/Logs/ZipKit.log"
  exit 1
fi

# 依次尝试能开窗口的 Python（Tk 必须 >= 8.6，8.5 在 macOS 26 上会崩）
PY=""
for candidate in \
  /usr/local/bin/python3 \
  /opt/homebrew/bin/python3 \
  /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
  /usr/bin/python3 \
  python3
do
  if command -v "$candidate" >/dev/null 2>&1; then
    if "$candidate" -c "import tkinter,sys; sys.exit(0 if tkinter.TkVersion>=8.6 else 1)" >/dev/null 2>&1; then
      PY="$candidate"
      log "选用 Python: $PY"
      break
    fi
    log "跳过（Tk 版本不满足）: $candidate"
  fi
done

if [ -z "$PY" ]; then
  show_error "没找到能开窗口的 Python（需要 Tk 8.6 以上）。

办法一：装官方 Python 3.13
        https://www.python.org/downloads/
办法二：用命令行，功能完全一样
        cd \"$PROJECT\"
        python3 -m zipkit unpack 你的文件.zip

日志：~/Library/Logs/ZipKit.log"
  exit 1
fi

cd "$PROJECT" || { show_error "无法进入项目目录：$PROJECT"; exit 1; }

# 关键：不让导入依赖"当前目录"。
# 从 Finder / launchd 启动时，Python 的 sys.path 可能不含 CWD
# （例如设置了 PYTHONSAFEPATH），于是 -m zipkit 会报 No module named zipkit。
export PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}"

log "PATH=$PATH"
log "PYTHONSAFEPATH=${PYTHONSAFEPATH:-未设置}  PYTHONPATH=$PYTHONPATH"

if ! "$PY" -c "import zipkit" >/dev/null 2>>"$LOG"; then
  show_error "Python 找不到 ZipKit 的程序文件。

项目目录：$PROJECT
Python：$PY

请确认 zipkit/ 文件夹是完整的（里面应该有 zipkit/core/、zipkit/gui.py）。

日志：~/Library/Logs/ZipKit.log"
  exit 1
fi

log "启动窗口 …"
"$PY" -m zipkit gui >>"$LOG" 2>&1
code=$?
log "退出码: $code"

if [ "$code" -ne 0 ] && [ "$code" -ne 130 ]; then
  show_error "程序异常退出（退出码 $code）。

详情见日志：~/Library/Logs/ZipKit.log
最后几行：
$(tail -5 "$LOG")"
fi

exit "$code"
